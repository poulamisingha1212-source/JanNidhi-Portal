# MPLADS AI Sentinel Environment Configuration Example
# Copy to .env and adjust values for your environment.

# Application Environment (development / staging / production)
ENVIRONMENT=development
PROJECT_NAME="MPLADS AI Sentinel"
VERSION="1.0.0"

# Database Configuration (PostgreSQL URL)
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mplads_sentinel
# For local development (automatic fallback):
DATABASE_URL=sqlite:///./mplads_sentinel.db

# API Configuration
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Live MPLADS Dashboard API (mplads.mospi.gov.in /digigov) — the only data
# source. The "live" sync mode pulls fresh per-work records from the
# dashboard's own REST endpoint. Houses: rajya_sabha (fast, ~60k rows) |
# lok_sabha (current term, ~90 MB payloads, minutes) | lok_sabha_17 | both.
MPLADS_LIVE_HOUSE=both
MPLADS_LIVE_TIMEOUT=300

# Authentication / JWT Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_secret_key
JWT_ALGORITHM=HS256
